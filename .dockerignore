# =====================================================================
# .dockerignore ÚNICO do projeto
#
# O docker-compose.yml usa "context: ." (raiz) nos dois builds, então
# o Docker lê SOMENTE este arquivo. Não crie .dockerignore dentro de
# backend/ ou frontend/: eles não teriam efeito.
#
# Imagens construídas a partir daqui:
#   - backend -> docker/backend/Dockerfile  (copia backend/)
#   - nginx   -> docker/nginx/Dockerfile    (compila frontend/ e serve com Nginx)
#
# ATENÇÃO: não ignore "docker/" (o Nginx copia docker/nginx/default.conf).
# =====================================================================


# ---------------------------------------------------------------------
# GERAL (vale para todas as imagens)
# ---------------------------------------------------------------------

# Controle de versão
**/.git
.gitignore

# Dependências (cada imagem roda seu próprio "npm install")
**/node_modules

# Logs
**/*.log
**/npm-debug.log*

# Arquivos de sistema e editor
**/.DS_Store
**/Thumbs.db
**/*Zone.Identifier
.vscode
.idea

# Arquivos compactados e documentos (não fazem parte da aplicação)
*.zip
*.docx
*.pdf

# Ferramentas de IA (uso local)
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude


# ---------------------------------------------------------------------
# SEGREDOS (nunca devem entrar em nenhuma imagem)
# ---------------------------------------------------------------------

# .env, .env.local, .env.ngrok, .env.docker, .env.example etc.
# (a configuração chega ao container pelo "environment:" do compose)
**/.env
**/.env.*

# Chaves e certificados
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/credentials.json
**/service-account*.json

# Token do túnel ngrok
ngrok.js
ngrok.yml


# ---------------------------------------------------------------------
# DADOS LOCAIS / VOLUMES (já são tratados pelo compose em runtime)
# ---------------------------------------------------------------------
mysql_data
minio_data
uploads_data
**/*.dump
**/*.bak


# ---------------------------------------------------------------------
# BACKEND (imagem "backend": docker/backend/Dockerfile)
# ---------------------------------------------------------------------

# Uploads locais: montados como volume em /app/uploads pelo compose
backend/uploads

# Coleção de testes manuais (não é usada em runtime)
backend/urban-reports.postman_collection.json


# ---------------------------------------------------------------------
# FRONTEND (imagem "nginx": etapa de build em docker/nginx/Dockerfile)
# ---------------------------------------------------------------------

# O build é refeito dentro da imagem
frontend/dist
frontend/.vite
