# Uso: desenvolvimento do backend FORA do Docker (cd backend && npm run dev).
# Copie para "backend/.env" e preencha. Com o Docker, use o ".env.example" da raiz.
NODE_ENV=development
PORT=3000

# O MySQL do compose é publicado em localhost:3307
DB_HOST=localhost
DB_PORT=3307
DB_NAME=base_projeto_integrador
DB_USER=admin
DB_PASSWORD=SUA_SENHA_DO_BANCO

# Se vazio, é gerado um segredo aleatório a cada início.
JWT_SECRET=
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@prefeitura.gov.br
SEED_ADMIN_EMAIL=admin@prefeitura.gov.br
SEED_ADMIN_PASSWORD=SUA_SENHA_DO_ADMIN
SEED_ADMIN_NAME=Administrador

CORS_ORIGIN=*

# local = grava em UPLOAD_DIR | minio = grava no MinIO
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=ocorrencias

# GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# Chave criada no Google AI Studio. Sem ela, as ocorrências seguem sem análise e sem sugestões.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=40000
