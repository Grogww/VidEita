# Copie para ".env" na raiz do projeto para sobrescrever os padrões de demonstração
# do docker-compose.yml. Tudo é opcional: sem este arquivo, o projeto sobe com os padrões.
# O ".env" está no .gitignore e nunca deve ser commitado.

# --- MySQL ---
# MYSQL_ROOT_PASSWORD=
# DB_NAME=base_projeto_integrador
# DB_USER=admin
# DB_PASSWORD=

# --- MinIO ---
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# --- Backend ---
# Se vazio, o backend gera um segredo aleatório a cada início (as sessões caem ao reiniciar).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=*

# --- Administrador do sistema (recriado a cada inicialização) ---
# SEED_ADMIN_EMAIL=admin@prefeitura.gov.br
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrador

# --- Login com Google (opcional) ---
# Client ID do tipo "Web application" criado no Google Cloud Console.
# VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# --- Análise de imagens com Gemini ---
# Chave criada no Google AI Studio. Sem ela, as ocorrências seguem sem análise e sem sugestões.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=40000
